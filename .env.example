# Domain served by the edge proxy. Must resolve to the VPS before first start,
# or certificate issuance will fail and back off.
# For apex + www, use a comma-separated list with no spaces and no quotes:
# blaai.example.com,www.blaai.example.com
BLAAI_DOMAIN=blaai.example.com

# Weaviate host ports
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Ollama endpoint.
# Host-native Ollama (default):   http://host.docker.internal:11434
# Ollama inside Compose profile:  http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models
LLM_MODEL=phi4-mini:3.8b-q4_K_M
EMBED_MODEL=embeddinggemma:latest