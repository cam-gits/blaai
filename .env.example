# Weaviate host ports
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Ollama endpoint.
# Host-native Ollama (default):   http://host.docker.internal:11434
# Ollama inside Compose profile:  http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Models
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text